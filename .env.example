OPENAI_API_KEY=
DATABASE_URL=postgresql://gallery:gallery@127.0.0.1:54329/gallery
VISION_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REASONING_EFFORT=none
GALLERY_DATA_DIR=./data
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Dedicated Bearer token for Vooy; create with scripts/setup_mcp_token.py.
# Keep blank only for local-only testing. Never use OPENAI_API_KEY here.
MCP_ACCESS_TOKEN=
# HTTPS tunnel origin only (no /mcp). Enables signed image URLs; restart server after changes.
MCP_PUBLIC_BASE_URL=
MCP_IMAGE_URL_TTL_SECONDS=900
# Enable search_videos/get_video after importing and indexing local videos.
VIDEO_ENABLED=false
VIDEO_GALLERY_ID=local-videos
# USD per million tokens; change these with the model to keep cost estimates valid.
VISION_INPUT_USD_PER_MILLION=0.10
VISION_OUTPUT_USD_PER_MILLION=0.50
EMBEDDING_INPUT_USD_PER_MILLION=0.02

GALLERY_ID=bts-daily
